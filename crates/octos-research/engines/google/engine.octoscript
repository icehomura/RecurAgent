// Google's results page for simple phones (www.google.com/wml/search): plain
// HTML, no JavaScript. The host fetches it with its `legacy_mobile` client
// (manifest `client`), the browser-like client the page answers, as SearXNG
// does; the request shape was observed black-box from SearXNG's network
// traffic. Written from the pages themselves (each result is a block
// holding a /url?q= link, its title and a snippet) and Google's
// search-operators help page (docs_url): `q` query, `hl` interface
// language, `lr` result language, `cr` country, `start` offset. An
// "unusual traffic" answer (a redirect to /sorry/) is a challenge: the
// engine is suspended, nothing is solved or worked around.
use mod.markup
use mod.net
use mod.std.array
use mod.std.object
use mod.std.text

fn lang_code(opts) {
    if opts.lang == nil {
        return nil
    }
    if opts.lang.primary == "zh" {
        if opts.lang.region == "TW" || opts.lang.region == "HK" {
            return "zh-TW"
        }
        return "zh-CN"
    }
    return opts.lang.primary
}

fn build_request(query, opts) {
    let q = query
    if opts.since != nil {
        q = q + " after:" + opts.since.date
    }
    let params = [["q", q], ["sca_esv", "1"]]
    let code = lang_code(opts)
    if code != nil {
        array.push(params, ["hl", code])
        array.push(params, ["lr", "lang_" + code])
    }
    let gl = if opts.region != nil {
        opts.region
    } elif opts.lang != nil {
        opts.lang.region
    } else {
        nil
    }
    if gl != nil {
        array.push(params, ["cr", "country" + text.upper(gl)])
    }
    if opts.page > 1 {
        array.push(params, ["start", (opts.page - 1) * 10])
    }
    array.push(params, ["ie", "utf8"])
    array.push(params, ["oe", "utf8"])
    let u = net.url({base: "https://www.google.com/wml/search", query: params})
    return net.request({url: u.url})
}

fn parse_response(response, opts) {
    let body = response.body
    let final_url = object.get(response.headers, "x_octos_final_url", "")
    if text.contains(final_url, "google.com/sorry/") {
        return {challenge: "Google reported unusual traffic"}
    }
    let found = markup.select({item: "div.zMzFAb", fields: {url: "a[href^=\"/url?q=\"]@href", title: "a[href^=\"/url?q=\"] span", snippet: "div.taTFJ"}})
    let out = []
    for r in found.items {
        if r.url == nil || r.title == nil || r.title == "" {
            continue
        }
        let url = markup.unwrap({url: r.url, base: "https://www.google.com/"}).url
        if !text.starts_with(url, "http") || text.contains(url, "google.com/") {
            continue
        }
        array.push(out, {url: url, title: r.title, snippet: r.snippet})
    }
    if array.len(out) == 0 && (text.contains(body, "unusual traffic") || text.contains(body, "g-recaptcha")) {
        return {challenge: "Google reported unusual traffic"}
    }
    return out
}
