# Copy to .env and adjust. Compose reads test/docker/.env automatically.

# --- source repo -----------------------------------------------------------
FLYWHEEL_REPO=https://github.com/icehomura/RecurAgent.git
FLYWHEEL_BRANCH=main
# 1 = clone/refresh at container start, 0 = use whatever is already there
CLONE=1

# --- image build -----------------------------------------------------------
TARGET_USER=ubuntu
# Must match the channel in ../../rust-toolchain.toml
RUST_TOOLCHAIN=nightly-2026-08-31
# acfs | direct | none
TOOLS_STRATEGY=direct
# vibe | safe | minimal | agents-only | cloud-only | stack-only
ACFS_PROFILE=stack-only
ACFS_REF=main
IMAGE_TAG=local

# --- mirrors (mainland-China defaults; see README "Network") ---------------
# How to fetch GitHub raw files: jsdelivr | ghproxy | direct
GH_RAW_MODE=jsdelivr
# How to fetch GitHub release assets: ghproxy | direct
GH_RELEASE_MODE=ghproxy
# ustc | rsproxy | none
CARGO_REGISTRY_MIRROR=ustc
# Ubuntu archive mirror inside the image (tuna works from containers here;
# USTC's apt mirror does not).
APT_MIRROR=http://mirrors.tuna.tsinghua.edu.cn/ubuntu
RUSTUP_DIST_SERVER=https://mirrors.ustc.edu.cn/rust-static
RUSTUP_UPDATE_ROOT=https://mirrors.ustc.edu.cn/rust-static/rustup
GOPROXY=https://goproxy.cn,direct
GOLANG_MIRROR=https://go.dev/dl
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# uv ignores PIP_INDEX_URL; it needs its own two knobs or it pulls packages from
# pypi.org and downloads its own CPython from GitHub.
UV_DEFAULT_INDEX=https://pypi.tuna.tsinghua.edu.cn/simple
UV_PYTHON_INSTALL_MIRROR=https://gh-proxy.com/https://github.com/astral-sh/python-build-standalone/releases/download
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# --- GitHub API token (optional but recommended) ---------------------------
# api.github.com allows 60 anonymous requests/hour per IP; a shared egress IP
# exhausts that, which breaks installers that resolve releases through the REST
# API (slb has no fallback). Passing a token lifts it to 5000/hour.
#GITHUB_TOKEN=ghp_xxx
# Or without writing it to disk:
#   GITHUB_TOKEN=$(gh auth token) docker compose build

# --- proxy (needed if raw.githubusercontent.com is blocked) ----------------
# e.g. Clash/Mihomo on the host: http://host.docker.internal:7890
#HTTP_PROXY=http://host.docker.internal:7890
#HTTPS_PROXY=http://host.docker.internal:7890
#NO_PROXY=localhost,127.0.0.1,::1

# --- compile budget --------------------------------------------------------
CARGO_BUILD_JOBS=2
